# URL del backend usada por la aplicación y por el seed opcional.
NEXT_PUBLIC_API_URL=https://api.example.com

# Opcional: solo para ejecutar `npm run seed:api` y cargar categorías/eventos
# de prueba en la base de datos mediante la API real. Estas variables no se
# exponen al navegador porque no comienzan por NEXT_PUBLIC_.
# El seed requiere una de estas dos alternativas:
# 1. Un JWT de un usuario administrador.
SEED_ACCESS_TOKEN=
#
# 2. Credenciales de un usuario administrador; el script iniciará sesión.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=